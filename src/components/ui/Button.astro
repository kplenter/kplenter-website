---
interface Props {
  href: string;
  variant?: "primary" | "ghost";
  external?: boolean;
  download?: boolean | string;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  external = false,
  download,
  ariaLabel,
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-medium tracking-wide transition-all duration-300";
const styles = {
  primary:
    "bg-secondary text-primary hover:bg-secondary-soft hover:-translate-y-px",
  ghost:
    "border border-secondary/40 text-secondary hover:border-secondary hover:bg-secondary/10",
};

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<a
  href={href}
  class={`${base} ${styles[variant]} ${className}`}
  rel={rel}
  target={target}
  download={download as never}
  aria-label={ariaLabel}
>
  <slot />
</a>
