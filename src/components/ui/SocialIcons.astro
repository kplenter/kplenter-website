---
import { type Lang, tStr } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const items = [
  {
    href: "mailto:info@k-plenter.de",
    label: tStr(lang, "hero.socialAriaEmail"),
    icon: "mail",
    external: true,
  },
  {
    href: "https://www.linkedin.com/in/kevin-plenter-16468b289/",
    label: tStr(lang, "hero.socialAriaLinkedIn"),
    icon: "linkedin",
    external: true,
  },
  {
    href: "https://github.com/kplenter",
    label: tStr(lang, "hero.socialAriaGitHub"),
    icon: "github",
    external: true,
  },
] as const;
---

<ul class="flex items-center gap-3">
  {items.map((item) => (
    <li>
      <a
        href={item.href}
        aria-label={item.label}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer" : undefined}
        class="flex size-10 items-center justify-center rounded-full border border-secondary/30 text-secondary transition-colors hover:border-secondary hover:bg-secondary hover:text-primary"
      >
        {item.icon === "mail" && (
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        )}
        {item.icon === "linkedin" && (
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.9-2 4-2 4.3 0 5.1 2.8 5.1 6.5V21H19v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21H10V9Z" />
          </svg>
        )}
        {item.icon === "github" && (
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.16 19.5c.5.1.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.04 1.53 1.04.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.08.63-1.33-2.22-.25-4.55-1.1-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.26-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.66.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.31.68.93.68 1.87v2.78c0 .27.18.59.69.49A10 10 0 0 0 12 2Z" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>
