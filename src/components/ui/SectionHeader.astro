---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { eyebrow, title, subtitle, align = "left" } = Astro.props;
const alignment =
  align === "center"
    ? "items-center text-center mx-auto"
    : "items-start text-left";
---

<div
  class={`flex max-w-2xl flex-col gap-4 ${alignment}`}
  data-reveal
>
  <span class="text-xs font-medium uppercase tracking-[0.2em] text-secondary">
    {eyebrow}
  </span>
  <h2 class="font-display text-3xl leading-tight md:text-4xl">
    {title}
  </h2>
  {subtitle && (
    <p class="text-base text-fg/70 md:text-lg">
      {subtitle}
    </p>
  )}
</div>
