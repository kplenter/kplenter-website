---
import { type Lang, tStr } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-secondary/10 bg-primary-deep">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm text-muted md:flex-row md:items-center md:px-8"
  >
    <p>
      © {year} Kevin Plenter. {tStr(lang, "footer.rights")}
    </p>
    <nav class="flex items-center gap-6" aria-label="Legal">
      <a
        href={tStr(lang, "footer.imprintHref")}
        class="transition-colors hover:text-secondary"
      >
        {tStr(lang, "footer.imprint")}
      </a>
      <a
        href={tStr(lang, "footer.privacyHref")}
        class="transition-colors hover:text-secondary"
      >
        {tStr(lang, "footer.privacy")}
      </a>
    </nav>
  </div>
</footer>
