---
import { getCollection } from "astro:content";
import SectionHeader from "../ui/SectionHeader.astro";
import TimelineEntry from "../ui/TimelineEntry.astro";
import { type Lang, tStr } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const entries = (await getCollection("cv", ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.order - a.data.order);
---

<section id="cv" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 md:px-8">
    <SectionHeader
      eyebrow={tStr(lang, "cv.eyebrow")}
      title={tStr(lang, "cv.title")}
    />

    <div class="relative mt-16">
      <span
        class="absolute left-4 top-0 bottom-0 w-px bg-linear-to-b from-transparent via-secondary/40 to-transparent md:left-1/2 md:-translate-x-1/2"
        aria-hidden="true"
      ></span>

      <ol class="flex flex-col gap-12 md:gap-16">
        {entries.map((entry, index) => (
          <TimelineEntry
            lang={lang}
            company={entry.data.company}
            role={entry.data.role}
            location={entry.data.location}
            start={entry.data.start}
            end={entry.data.end}
            summary={entry.data.summary}
            stack={entry.data.stack}
            side={index % 2 === 0 ? "left" : "right"}
            index={index}
          />
        ))}
      </ol>
    </div>
  </div>
</section>
