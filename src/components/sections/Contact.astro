---
import Button from "../ui/Button.astro";
import SocialIcons from "../ui/SocialIcons.astro";
import { type Lang, tStr } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="contact" class="relative py-24 md:py-32">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-8 px-6 text-center md:px-8"
  >
    <span
      class="text-xs font-medium uppercase tracking-[0.3em] text-secondary"
      data-reveal
    >
      {tStr(lang, "contact.eyebrow")}
    </span>
    <h2
      class="font-display text-4xl leading-tight md:text-5xl"
      data-reveal
      style="--reveal-delay: 80ms"
    >
      {tStr(lang, "contact.title")}
    </h2>
    <p
      class="max-w-xl text-base leading-relaxed text-fg/80 md:text-lg"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      {tStr(lang, "contact.body")}
    </p>
    <div
      class="flex flex-col items-center gap-6 pt-2"
      data-reveal
      style="--reveal-delay: 240ms"
    >
      <Button href="mailto:info@k-plenter.de" variant="primary">
        {tStr(lang, "contact.cta")} → info@k-plenter.de
      </Button>
      <SocialIcons lang={lang} />
    </div>
  </div>
</section>
