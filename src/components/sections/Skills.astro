---
import { getEntry } from "astro:content";
import SectionHeader from "../ui/SectionHeader.astro";
import Tag from "../ui/Tag.astro";
import { type Lang, tStr } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const skills = await getEntry("skills", "main");
const categories = skills?.data.categories ?? [];
---

<section id="skills" class="relative py-24 md:py-32">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6 md:px-8">
    <SectionHeader
      eyebrow={tStr(lang, "skills.eyebrow")}
      title={tStr(lang, "skills.title")}
      subtitle={tStr(lang, "skills.subtitle")}
    />

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      {categories.map((category, ci) => (
        <div
          class="rounded-2xl border border-secondary/15 bg-primary-soft/30 p-6 md:p-7"
          data-reveal
          style={`--reveal-delay: ${ci * 80}ms`}
        >
          <h3 class="font-display text-xl text-fg">
            {category.label[lang]}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {category.items.map((item, ii) => (
              <li>
                <Tag delay={ii * 30}>{item}</Tag>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
